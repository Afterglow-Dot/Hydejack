# Ignore docs files
_site
_drafts
build
dist

# Numerous always-ignore extensions
*.diff
*.err
*.orig
*.log
*.rej
*.swo
*.swp
*.vi
*~

# OS or Editor folders
.DS_Store
._*
Thumbs.db
.cache
.project
.settings
.tmproj
*.esproj
nbproject
*.sublime-project
*.sublime-workspace
.idea

# Folders to ignore
node_modules
package-lock.json
vendor
.sass-cache
.jekyll-metadata
.jekyll-cache
.ruby-lsp
.wrangler
*.gem
Gemfile.lock
_zip
/stats.json
.dev.vars

/assets/js/*hydejack-*
/_sass/*/__*__/*

# 标签 / 分类归档页由 scripts/gen_archives.py 在构建时生成
/_featured_tags/
/_featured_categories/

# 博客分页页（第 2 页起）由 scripts/gen_pagination.py 在构建时生成
/_pages/blog-page-*.md


# Python
__pycache__/
*.pyc
